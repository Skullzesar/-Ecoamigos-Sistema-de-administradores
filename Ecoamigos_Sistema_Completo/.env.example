# Copia este archivo como ".env" y rellena tus datos. El archivo ".env" NO se sube a GitHub.

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sistema_recoleccion

# --- Flask ---
# Genera una clave larga y aleatoria para producción:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# 1 = modo desarrollo (recarga automática y errores detallados). En producción: 0
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000
